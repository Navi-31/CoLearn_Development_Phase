############################################################
# CoLearn Backend Environment Variables
############################################################
# Copy this file to:
#
#     .env
#
# Then replace all placeholder values with your own.
#
# This file contains NO secrets and is safe to commit.
############################################################


############################################################
# Security & Session Signing
############################################################

# Strong random secret for HMAC session and OAuth state signing (minimum 32 characters)
SESSION_SECRET=your-32-char-random-session-secret-here


############################################################
# Server Configuration
############################################################

PORT=3000
NODE_ENV=development

# Your local IPv4 address (development only)
# Example:
# Windows -> ipconfig
# Mac/Linux -> ifconfig or ip addr
HOST_IP=192.168.1.100

# Allowed frontend origins (CORS)
# Development (allows local LAN and localhost):
ALLOWED_ORIGINS=*

# Production Example (Cloudflare Pages frontend + custom domain):
# ALLOWED_ORIGINS=https://colearn.pages.dev,https://yourdomain.com


############################################################
# SMTP (Gmail)
############################################################

SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM_NAME=CoLearn


############################################################
# Firebase Admin & Client Configuration
############################################################

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Local Development: Path to Firebase Admin SDK JSON file
FIREBASE_KEY_PATH=./config/serviceAccountKey.json

# Production Cloud Hosts (Render, Railway, Fly.io, etc.):
# Alternatively, store the service account JSON directly in environment secrets (raw JSON or base64)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"your-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id"}

# Firebase Web API Key
FIREBASE_API_KEY=your-firebase-web-api-key

# Firebase Realtime Database URL (optional)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com


############################################################
# Application & Deployment URLs
############################################################

# Backend server URL (used for Google OAuth callback derivation)
# Development:
BACKEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Frontend URL (e.g. Cloudflare Pages deployment URL, used for invite links and referrers)
# Development (defaults to request host):
# FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://colearn.pages.dev


############################################################
# Google OAuth (Google Drive Integration)
############################################################

# These credentials identify the CoLearn application.
#
# Every user logs into THEIR OWN Google account.
#
# Each user uploads files into THEIR OWN Google Drive.
#
# Only ONE OAuth Client is required for the entire application.

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redirect URI is automatically derived from APP_URL.
#
# Development:
# http://localhost:3000/api/drive/callback
#
# Production:
# https://yourdomain.com/api/drive/callback

# GOOGLE_REDIRECT_URI=

############################################################
# OpenRouter API (AI Study Partner)
############################################################

# Your OpenRouter API Key (get it from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# Default AI Model to use
OPENROUTER_MODEL=google/gemini-2.5-flash