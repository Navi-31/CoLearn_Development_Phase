############################################################
# CoLearn Backend Environment Variables
############################################################
# Copy this file to:
#
#     .env
#
# Then replace all placeholder values with your own.
#
# This file contains NO secrets and is safe to commit.
############################################################


############################################################
# Security & Session Signing
############################################################

# Strong random secret for HMAC session and OAuth state signing (minimum 32 characters)
SESSION_SECRET=your-32-char-random-session-secret-here


############################################################
# Server Configuration
############################################################

PORT=3000
NODE_ENV=development

# Your local IPv4 address (development only)
# Example:
# Windows -> ipconfig
# Mac/Linux -> ifconfig or ip addr
HOST_IP=192.168.1.100

# Allowed frontend origins (CORS)
# Development (allows local LAN and localhost):
ALLOWED_ORIGINS=*

# Production Example (GitHub Pages / Cloudflare Pages / custom domain):
# ALLOWED_ORIGINS=https://navi-31.github.io,https://colearn.pages.dev


############################################################
# SMTP (Gmail / Custom SMTP)
############################################################

SMTP_USER=your-email@gmail.com
# 16-character Google App Password (any spaces from Google's UI are stripped automatically)
SMTP_PASS=your-16-character-app-password
EMAIL_FROM_NAME=CoLearn

# Optional SMTP Settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587          # Use 587 for STARTTLS (default) or 465 for SSL direct
# SMTP_SECURE=false      # Set true if using port 465
# SMTP_IGNORE_TLS=false  # Set true only to bypass strict TLS verification in local test


############################################################
# Firebase Admin & Client Configuration
############################################################

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Local Development: Path to service-account JSON file (relative to backend directory)
FIREBASE_KEY_PATH=./config/serviceAccountKey.json

# Production: Protected deployment environment secret in cloud dashboard (Render/Railway/Fly.io)
# Provide the full service-account JSON string or base64-encoded JSON. Never commit actual credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web API Key (Public Client SDK Configuration)
# Served to browser via GET /api/config/firebase to initialize client-side Firebase Auth.
# If applying Google Cloud Console "Websites (HTTP referrers)" key restrictions:
# Add authorized referrers:
#   - http://localhost:3000/*
#   - https://navi-31.github.io/*
#   - https://<project-id>.firebaseapp.com/*
FIREBASE_API_KEY=your-firebase-web-api-key

# Firebase Auth Domain (defaults to <project-id>.firebaseapp.com if omitted)
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Realtime Database URL (optional)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com


############################################################
# Application & Deployment URLs
############################################################

# Backend server URL (used for Google OAuth callback derivation)
# Development:
BACKEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Frontend URL (e.g. Cloudflare Pages deployment URL, used for invite links and referrers)
# Development (defaults to request host):
# FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://colearn.pages.dev


############################################################
# Google OAuth (Google Drive Integration)
############################################################

# These credentials identify the CoLearn application.
#
# Every user logs into THEIR OWN Google account.
#
# Each user uploads files into THEIR OWN Google Drive.
#
# Only ONE OAuth Client is required for the entire application.

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redirect URI is automatically derived from APP_URL.
#
# Development:
# http://localhost:3000/api/drive/callback
#
# Production:
# https://yourdomain.com/api/drive/callback

# GOOGLE_REDIRECT_URI=

############################################################
# OpenRouter API (AI Study Partner)
############################################################

# Your OpenRouter API Key (get it from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# Default AI Model to use
OPENROUTER_MODEL=google/gemini-2.5-flash