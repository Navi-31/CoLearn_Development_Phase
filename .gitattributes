# ──────────────────────────────────────────────────────────────────
# .gitattributes — CoLearn
# Normalize line endings across platforms.
# Ensures consistent diffs and prevents CRLF/LF conflicts.
# ──────────────────────────────────────────────────────────────────

# Default: auto-normalize text files
* text=auto

# ── Explicit text files (always LF in repo) ───────────────────────
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf

*.json      text eol=lf
*.json5     text eol=lf

*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf

*.yml       text eol=lf
*.yaml      text eol=lf

*.sh        text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf

# ── Binary files (never diff/merge) ──────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.webp      binary
*.mp4       binary
*.mp3       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary

# ── GitHub Linguist — mark generated files ────────────────────────
package-lock.json   linguist-generated=true
